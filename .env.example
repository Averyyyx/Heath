# Hearth server configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:4000
CORS_ORIGIN=http://localhost:4000

# Leave the developer account disabled unless running a trusted local instance.
HEARTH_DEV_ACCOUNT=false
HEARTH_DEV_EMAIL=dev@hearth.local
HEARTH_DEV_PASSWORD=

# Set unique, random values outside local development.
SESSION_SECRET=
JWT_SECRET=

# Optional data locations
DB_PATH=
DATA_DIR=
