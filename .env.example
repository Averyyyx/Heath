# Hearth server configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:4000
CORS_ORIGIN=http://localhost:4000
TRUST_PROXY=false

# Authentication and sessions. Use unique random values outside local development.
SESSION_SECRET=
JWT_SECRET=
SESSION_PREFIX=hearth:
SESSION_TTL_MS=604800000

# Optional GitHub OAuth login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Local developer account. Keep disabled outside trusted development.
HEARTH_DEV_ACCOUNT=false
HEARTH_DEV_EMAIL=dev@hearth.local
HEARTH_DEV_PASSWORD=

# Data storage and optional Redis session backend
DATA_DIR=
DB_PATH=
REDIS_URL=redis://127.0.0.1:6379
USE_MEMORY_SESSION=false
ELECTRON_DESKTOP=0

# Upload and password policy
MAX_UPLOAD_BYTES=26214400
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,video/mp4,application/pdf
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.mp4,.pdf
PASSWORD_MIN_SCORE=3
REQUIRE_HTTPS=false

# Optional premium branding and balance token
PREMIUM_BRAND=Hearth Plus
PREMIUM_BALANCE_TOKEN=
